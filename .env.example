# Supabase project used by the web app (Project Settings → API).
# The publishable key is safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: Postgres connection string for the Supabase CLI (migrations, type generation).
# Server-side only. Use the session pooler string (Dashboard → Connect).
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
